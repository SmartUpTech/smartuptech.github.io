---
import { apps } from '../data/apps';
const currentYear = new Date().getFullYear();
---

<footer class="py-16 md:py-24 border-t border-gray-100 bg-white">
	<div class="max-w-[1400px] mx-auto px-4 sm:px-6 md:px-12">
		<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-10 md:gap-12">
			<div class="sm:col-span-2">
				<a href="/" class="text-xl font-bold tracking-tighter inline-block">
					SmartUp<span class="font-normal text-gray-400 ml-1">Tech</span>
				</a>
				<p class="mt-4 max-w-sm text-gray-500 text-sm sm:text-base">
					Building premium utility tools for everyday life.
					Simple, thoughtful, and private apps for millions of users worldwide.
				</p>
			</div>

			<div class="flex flex-col gap-3">
				<span class="font-semibold text-black uppercase text-xs tracking-widest">Android Apps</span>
				{apps.map(app => (
					<a href={`/apps/${app.id}`} class="text-sm text-gray-500 hover:text-black transition-colors py-1 min-h-[44px] md:min-h-0 flex items-center">{app.name}</a>
				))}
			</div>

			<div class="flex flex-col gap-3">
				<span class="font-semibold text-black uppercase text-xs tracking-widest">Links</span>
				<a href="/about" class="text-sm text-gray-500 hover:text-black transition-colors py-1 min-h-[44px] md:min-h-0 flex items-center">About Us</a>
				<a href="/contact" class="text-sm text-gray-500 hover:text-black transition-colors py-1 min-h-[44px] md:min-h-0 flex items-center">Contact</a>
				<a href="/apps" class="text-sm text-gray-500 hover:text-black transition-colors py-1 min-h-[44px] md:min-h-0 flex items-center">All Apps</a>
				<a href="/articles" class="text-sm text-gray-500 hover:text-black transition-colors py-1 min-h-[44px] md:min-h-0 flex items-center">Articles</a>
				<a href="https://play.google.com/store/apps/dev?id=6614685995890456247" target="_blank" rel="noopener noreferrer" data-track-playstore data-app-name="SmartUp Tech Developer Profile" class="text-sm text-gray-500 hover:text-black transition-colors py-1 min-h-[44px] md:min-h-0 flex items-center">Developer Profile</a>
				<a href="/privacy_policy.html" class="text-sm text-gray-500 hover:text-black transition-colors py-1 min-h-[44px] md:min-h-0 flex items-center">Privacy Policy</a>
			</div>
		</div>

		<div class="mt-16 md:mt-24 pt-8 border-t border-gray-50 flex flex-col md:flex-row justify-between items-center text-xs text-gray-400 gap-4 text-center md:text-left">
			<p>&copy; {currentYear} SmartUp Tech. All rights reserved.</p>
			<div class="flex flex-col sm:flex-row flex-wrap justify-center md:justify-end gap-x-8 gap-y-3">
				<a href="https://clients.hostingraja.in/aff/bdade9f3b6de457cc99636dcb06cd4860ad15980" target="_blank" rel="noopener noreferrer sponsored" class="hover:text-black transition-colors min-h-[44px] md:min-h-0 flex items-center justify-center">Hosted with HostingRaja</a>
				<a href="https://play.google.com/store/apps/dev?id=6614685995890456247" target="_blank" rel="noopener noreferrer" data-track-playstore data-app-name="SmartUp Tech Developer Profile" class="hover:text-black transition-colors underline underline-offset-4 min-h-[44px] md:min-h-0 flex items-center justify-center">More Apps on Google Play</a>
			</div>
		</div>
	</div>
</footer>
