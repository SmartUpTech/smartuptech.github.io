---
import type { App } from '../data/apps';
import type { Article } from '../data/articles';
import { apps } from '../data/apps';

interface Props {
	app?: App;
	article?: Article;
	title?: string;
	description?: string;
	ogImage?: string;
	isHomePage?: boolean;
}

const { app, article, title, description, isHomePage = false } = Astro.props;
let { ogImage = "/og-image.png" } = Astro.props;

if (article?.coverImage && !Astro.props.ogImage) {
  ogImage = article.coverImage;
}

const siteUrl = Astro.site || "https://www.smartuptech.in";

function normalizePath(pathname: string): string {
	let path = pathname;

	if (path === "/index.html" || path === "/index" || path === "/") {
		return "/";
	}

	if (path.endsWith(".html")) {
		path = path.slice(0, -5) || "/";
	}

	if (path.endsWith("/") && path.length > 1) {
		path = path.slice(0, -1);
	}

	return path;
}

const normalizedPath = normalizePath(Astro.url.pathname);
const canonicalURL = new URL(normalizedPath, siteUrl);
const ogImageURL = new URL(ogImage, siteUrl);

const seoTitle = article
  ? article.title
  : (app
    ? (app.seoTitle || `${app.name} — ${app.tagline} | Android App`)
    : (title ? title : "SmartUp Tech | Quality Android Applications for Everyday Life"));

const seoDescription = article
  ? article.excerpt
  : (app
    ? `${app.shortDescription} Download ${app.name} for Android on Google Play. ${app.features.slice(0, 3).join(', ')}.`
    : (description || "SmartUp Tech develops high-impact Android applications focused on utility, cultural heritage, and daily productivity for millions of users worldwide."));

const applicationCategoryMap: Record<string, string> = {
  "Finance": "FinanceApplication",
  "Productivity": "UtilitiesApplication",
  "Utility & Lifestyle": "LifestyleApplication",
  "Information": "UtilitiesApplication",
  "Culture": "LifestyleApplication",
};

// Structured Data for App
const appJsonLd = app ? {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": app.name,
  "operatingSystem": "ANDROID",
  "applicationCategory": applicationCategoryMap[app.category] || "UtilitiesApplication",
  "downloadUrl": app.playStoreUrl,
  "installUrl": app.playStoreUrl,
  "image": new URL(app.icon, siteUrl).href,
  "author": {
    "@type": "Organization",
    "name": "SmartUp Tech",
    "url": siteUrl.href
  },
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": app.longDescription,
  "featureList": app.features,
  "keywords": app.seoKeywords.join(", ")
} : null;

// Organization Schema for Home Page
const orgJsonLd = isHomePage ? {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "SmartUp Tech",
  "url": siteUrl.href,
  "logo": new URL("/smart-up-tech.webp", siteUrl).href,
  "description": "SmartUp Tech develops useful Android applications for everyday life, including Hindu Panchang, calculators, and cultural calendars.",
  "contactPoint": {
    "@type": "ContactPoint",
    "email": "smartlogic08@gmail.com",
    "contactType": "customer service"
  },
  "sameAs": [
    "https://play.google.com/store/apps/dev?id=6614685995890456247"
  ]
} : null;

// WebSite Schema for Home Page
const websiteJsonLd = isHomePage ? {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "SmartUp Tech",
  "url": siteUrl.href,
  "description": seoDescription,
  "publisher": {
    "@type": "Organization",
    "name": "SmartUp Tech"
  }
} : null;

// Article Schema
const articleJsonLd = article ? {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": article.title,
  "description": article.excerpt,
  "image": new URL(article.coverImage, siteUrl).href,
  "author": {
    "@type": "Organization",
    "name": "SmartUp Tech",
    "url": siteUrl.href
  },
  "publisher": {
    "@type": "Organization",
    "name": "SmartUp Tech",
    "logo": {
      "@type": "ImageObject",
      "url": new URL("/smart-up-tech.webp", siteUrl).href
    }
  },
  "datePublished": article.publishDate
} : null;

// Breadcrumb Schema
const breadcrumbs = [];
const pathSegments = normalizedPath.split('/').filter(Boolean);
if (pathSegments.length > 0) {
	breadcrumbs.push({
		"@type": "ListItem",
		"position": 1,
		"name": "Home",
		"item": new URL("/", siteUrl).href
	});
	pathSegments.forEach((segment, index) => {
		const segmentPath = `/${pathSegments.slice(0, index + 1).join('/')}`;
		const matchedApp = pathSegments[0] === 'apps'
			? apps.find((entry) => entry.id === segment)
			: undefined;

		breadcrumbs.push({
			"@type": "ListItem",
			"position": index + 2,
			"name": matchedApp?.name || segment.charAt(0).toUpperCase() + segment.slice(1).replace(/-/g, ' '),
			"item": new URL(segmentPath, siteUrl).href
		});
	});
}

const breadcrumbJsonLd = breadcrumbs.length > 0 ? {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": breadcrumbs
} : null;
---

<!-- Primary Meta Tags -->
<title>{seoTitle}</title>
<meta name="title" content={seoTitle} />
<meta name="description" content={seoDescription} />
<link rel="canonical" href={canonicalURL} />
<meta name="robots" content="index, follow" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={article ? "article" : (app ? "website" : "website")} />
<meta property="og:site_name" content="SmartUp Tech" />
<meta property="og:locale" content="en_IN" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={seoTitle} />
<meta property="og:description" content={seoDescription} />
<meta property="og:image" content={ogImageURL} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={seoTitle} />
<meta name="twitter:description" content={seoDescription} />
<meta name="twitter:image" content={ogImageURL} />

{appJsonLd && (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(appJsonLd)} />
)}

{orgJsonLd && (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(orgJsonLd)} />
)}

{websiteJsonLd && (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteJsonLd)} />
)}

{articleJsonLd && (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(articleJsonLd)} />
)}

{breadcrumbJsonLd && (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)} />
)}
